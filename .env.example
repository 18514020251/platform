# =========================================================
# Platform local development environment variables
# Copy this file to .env and replace the values as needed.
# Do not commit the real .env file.
# =========================================================

# ---------- Common ----------
APP_VERSION=1.0.0
SPRING_PROFILES_ACTIVE=local
TZ=Asia/Shanghai

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=change_me_mysql_root_password
MYSQL_PASSWORD=change_me_mysql_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USERNAME=root


# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# ---------- MongoDB ----------
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_DATABASE=platform_log
MONGODB_URI=mongodb://127.0.0.1:27017/platform_log

# ---------- Elasticsearch ----------
ELASTICSEARCH_HOST=127.0.0.1
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URIS=http://127.0.0.1:9200
ES_JAVA_OPTS=-Xms1g -Xmx1g

# ---------- Nacos ----------
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP

# ---------- MinIO ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=platform

# ---------- RabbitMQ ----------
# Current project stage can keep RabbitMQ as a reserved component.
RABBITMQ_DEFAULT_USER=platform
RABBITMQ_DEFAULT_PASS=change_me_rabbitmq_password
RABBITMQ_DEFAULT_VHOST=/platform

# ---------- Internal service token ----------
# Use the same value in services that call /internal/** endpoints.
PLATFORM_INTERNAL_TOKEN=change_me_internal_token

# ---------- AI providers ----------
# Fill in only when you need AI/RAG features.
DEEPSEEK_KEY=your_deepseek_api_key
DASHSCOPE_API_KEY=your_dashscope_api_key

# ---------- Access log ----------
ACCESS_LOG_MONGO_ENABLED=true
ACCESS_LOG_COLLECTION=platform_access_log
ACCESS_LOG_CREATE_INDEXES=true
ACCESS_LOG_TTL_DAYS=30
ACCESS_LOG_ASYNC_CORE_POOL_SIZE=2
ACCESS_LOG_ASYNC_MAX_POOL_SIZE=4
ACCESS_LOG_ASYNC_QUEUE_CAPACITY=1000
ACCESS_LOG_ASYNC_THREAD_NAME_PREFIX=access-log-
ACCESS_LOG_ASYNC_AWAIT_TERMINATION_SECONDS=3

# ---------- Service ports ----------
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
WORKFLOW_SERVICE_PORT=8082
KNOWLEDGE_SERVICE_PORT=8083
AI_SERVICE_PORT=8084
LOG_SERVICE_PORT=8085

WORKFLOW_SERVICE_URL=http://localhost:8082
KNOWLEDGE_SERVICE_URL=http://localhost:8083
AI_SERVICE_URL=http://localhost:8084
LOG_SERVICE_URL=http://localhost:8085

ELASTICSEARCH_SECURITY_ENABLED=false